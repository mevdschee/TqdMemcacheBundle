{
    "name": "leaseweb/memcache-bundle",
    "type": "symfony-bundle",
    "description": "Memcache Doctrine caching and session storage in the Web Debug Toolbar",
    "keywords": ["memcache","memcached","cache","session"],
    "homepage": "http://www.leaseweblabs.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Maurits van der Schee",
            "email": "m.vanderschee@leaseweb.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-memcache": "*",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5.52",
        "doctrine/cache": "^2.0",
        "symfony/twig-bundle": "^6.4 || ^7.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.0"
    },
    "suggest": {
        "doctrine/cache": "Required for the Doctrine cache integration"
    },
    "autoload": {
        "psr-4": { "Tqd\\MemcacheBundle\\": "" },
        "exclude-from-classmap": ["/Tests/"]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.0.x-dev"
        }
    }
}
